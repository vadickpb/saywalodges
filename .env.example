# ─────────────────────────────────────────────────────────────
# Saywa Lodges — environment variables
# Copy this file to .env.local and fill in your values.
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Production URL (no trailing slash).
# Used for: OG images, sitemap, canonical URLs, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://saywalodges.com

# Airbnb listing iCal / embed URL.
# Leave empty until your listing is live — the Availability section
# shows a WhatsApp placeholder in the meantime.
NEXT_PUBLIC_AIRBNB_URL=

# ── Admin panel credentials (/admin) ──────────────────────────────────────────
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) — never sent to the browser.
# Set both in Vercel → Settings → Environment Variables.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-deploying
