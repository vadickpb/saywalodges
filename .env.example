# ─────────────────────────────────────────────────────────────
# Saywa Lodges — environment variables
# Copy this file to .env.local and fill in your values.
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Production URL (no trailing slash).
# Used for: OG images, sitemap, canonical URLs, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://saywalodges.com

# ── Supabase (Postgres + Storage) ──────────────────────────────────────────────
# Server-only — never sent to the browser. Used by the service-role admin
# client (lib/supabase/admin.ts), restricted to webhooks/cron/RPCs.
# Get these from Supabase → Project Settings → API Keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public by design — the anon key is meant to be exposed to the browser;
# RLS (not secrecy) is what protects data behind it. Used by the
# session-aware clients (lib/supabase/server.ts, lib/supabase/browser.ts).
# Local dev: run `npx supabase status -o env` for these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Multi-tenant host routing (proxy.ts) ────────────────────────────────────────
# Server-only. "{sub}.ROOT_DOMAIN" → tenant site, "app.ROOT_DOMAIN" → dashboard,
# bare ROOT_DOMAIN → landing. "host:port" in dev, bare domain in production.
# Optional locally — defaults to localhost:3000. Must be set for real in
# Vercel → Settings → Environment Variables for production.
ROOT_DOMAIN=localhost:3000

# ── Deployment mode (SD-1001, ADR 0010) ────────────────────────────────────────
# Server-only. "platform" (default) is how Saywa runs today: tenant sites under
# {sub}.ROOT_DOMAIN. "installation" is one installation per client: ROOT_DOMAIN IS the client's
# public site (found by properties.custom_domain = ROOT_DOMAIN) and app.ROOT_DOMAIN serves the
# panel, login, auth and every /api/* route (cron, iCal, health, webhooks). Any other host is 404.
# In production, installation mode REQUIRES NEXT_PUBLIC_SITE_URL=https://app.<ROOT_DOMAIN>.
DEPLOYMENT_MODE=platform

# ── Transactional email (lib/email, SD-306) ─────────────────────────────────────
# All optional: without RESEND_API_KEY, non-production environments SIMULATE
# sends (rendered + logged, nothing delivered) and the build never needs a key.
# Production without a key refuses to send (no silent simulation).
# Server-only — never NEXT_PUBLIC_*.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Saywa Direct <reservas@mail.example.com>".
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional override: "simulate" | "resend". Default: resend if a key is set.
EMAIL_MODE=
# Who the emails speak as (SD-1005). In an installation: the lodging's name. Default: "Saywa Direct".
EMAIL_BRAND_NAME=
# "true" adds "Powered by Saywa Direct" to the footer (only when EMAIL_BRAND_NAME is set to something else).
EMAIL_POWERED_BY=
# Non-production only: comma-separated addresses or "@domain" entries that may
# receive real email. Empty = nobody (a preview can never mail a real guest).
EMAIL_ALLOWED_RECIPIENTS=
# Non-production only: enables POST /api/email/test (Bearer token, >= 16 chars).
EMAIL_TEST_SECRET=

# SD-407. Arrival instructions are required only for arrival events (server-only, per installation).
# Arrival reminder lead time, 0–30 days (default 3); confirmed bookings only, America/Lima.
EMAIL_ARRIVAL_DAYS=3
# Actual arrival/access instructions, maximum 4000 characters each. Never logged.
EMAIL_ARRIVAL_INSTRUCTIONS_ES=
EMAIL_ARRIVAL_INSTRUCTIONS_EN=

# ── Cron (SD-408) ───────────────────────────────────────────────────────────────
# Server-only. Bearer secret for GET/POST /api/cron/expire-holds. At least 32 random
# characters (e.g. `openssl rand -hex 32`). Without it the route answers 401 to
# everyone, so nothing runs by accident. See docs/cron.md.
CRON_SECRET=

# ── Health (SD-1004) ─────────────────────────────────────────────────────────────
# Server-only. Bearer secret for GET /api/health, read by the owner's scheduled monitor
# (.github/workflows/installation-health.yml). At least 32 random characters, DIFFERENT from CRON_SECRET
# (`openssl rand -hex 32`). Without it the route answers 401 to everyone. See docs/health.md.
HEALTH_SECRET=

# ── Demo (SD-1007) ───────────────────────────────────────────────────────────────
# Server-only. "true" ONLY on the shared demo installation: shows the "resets every night" banner in the dashboard.
# Changes no behaviour. See docs/demo.md.
DEMO_MODE=

# ── WhatsApp Business Cloud API (SD-1008) ───────────────────────────────────────────
# All optional and server-only. Without credentials, non-production environments SIMULATE sends (logged and recorded,
# nothing leaves); production without them refuses to send. One number per installation. docs/whatsapp.md.
WHATSAPP_ACCESS_TOKEN=            # permanent token of a System User (Meta Business Settings)
WHATSAPP_PHONE_NUMBER_ID=         # digits; from the WhatsApp app's API Setup
# Optional: "simulate" | "live". Default: live if a token is set or in production, else simulate.
WHATSAPP_MODE=
# Graph API version, e.g. v23.0. REQUIRED for live mode (no default: Meta retires versions); look up the current one.
WHATSAPP_API_VERSION=
# Webhook (POST /api/whatsapp/webhook on app.<domain>). Each at least 16 characters.
WHATSAPP_APP_SECRET=              # the app's "App secret"; signs every webhook POST (X-Hub-Signature-256)
WHATSAPP_VERIFY_TOKEN=            # any random string you choose (`openssl rand -hex 16`); Meta echoes it in the GET handshake

# ── CSP (SD-701) ────────────────────────────────────────────────────────────────
# Server-only. Set to 1 to send the CSP as Report-Only (nothing blocked) while validating a
# PREVIEW; leave unset/0 to enforce. It is ignored on a Vercel Production deployment (VERCEL_ENV=production).
# See docs/adr/0011-csp-and-security-headers.md.
CSP_REPORT_ONLY=
