# ─────────────────────────────────────────────────────────────
# Saywa Lodges — environment variables
# Copy this file to .env.local and fill in your values.
# Variables prefixed NEXT_PUBLIC_* are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Production URL (no trailing slash).
# Used for: OG images, sitemap, canonical URLs, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://saywalodges.com

# ── Supabase (Postgres + Storage) ──────────────────────────────────────────────
# Server-only — never sent to the browser. Property profile, rooms, rates,
# amenities, distances and photos all live here now (see lib/property.ts,
# lib/spaces.ts, lib/photos.ts). The Airbnb URL is also stored on the
# properties row and edited from /admin, not as an env var anymore.
# Get these from Supabase → Project Settings → API Keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin panel credentials (/admin) ──────────────────────────────────────────
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) — never sent to the browser.
# Set both in Vercel → Settings → Environment Variables.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-before-deploying
